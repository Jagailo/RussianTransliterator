# Normalize line endings to LF in the repository; checkout uses the platform default.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.md      text diff=markdown
*.json    text
*.xml     text

*.png     binary
*.jpg     binary
*.ico     binary
*.dll     binary
*.exe     binary
*.nupkg   binary
*.snk     binary
